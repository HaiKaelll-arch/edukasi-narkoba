<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edukasi Bahaya Narkoba | PIK-R JP ONE</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- CSS -->
    <link rel="stylesheet" href="intro.css">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="scroll-animations.css">
    <link rel="stylesheet" href="about-pikr.css">
</head>

<body data-theme="dark">
    <!-- ============================================
         INTERACTIVE HERO ANIMATION
         "Perjalanan Memilih Masa Depan Bebas Narkoba"
         ============================================ -->

    <!-- Intro Loading Screen -->
    <div id="intro-loader">
        <div class="intro-loader-ring"></div>
        <p class="intro-loader-text">Memuat Pengalaman</p>
        <div class="intro-loader-bar">
            <div class="intro-loader-bar-fill"></div>
        </div>
    </div>

    <!-- Intro Animation Container -->
    <div id="intro-animation">
        <canvas id="intro-particles"></canvas>

        <!-- Scene 1: Dunia Gelap -->
        <div class="intro-scene" id="scene-1">
            <div class="city-silhouette"></div>
            <div class="fog-layer"></div>
            <div class="glitch-overlay"></div>
            <div class="scene1-text">
                <h1>Setiap Pilihan<br>Menentukan <span>Masa Depan</span></h1>
                <p class="subtitle">PIK-R JP ONE</p>
            </div>
            <div class="scroll-hint">
                <div class="mouse"></div>
                <span>Menonton</span>
            </div>
        </div>

        <!-- Scene 2: Ancaman Narkoba -->
        <div class="intro-scene" id="scene-2">
            <div class="floating-drugs">
                <div class="drug-obj"><i class="fa-solid fa-pills"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-capsules"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-syringe"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-prescription-bottle-medical"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-smoking"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-cannabis"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-tablets"></i></div>
                <div class="drug-obj"><i class="fa-solid fa-bong"></i></div>
            </div>
            <div class="warning-ring"></div>
            <div class="scene2-text">
                <h2><strong>Narkoba</strong> dapat merusak <strong>kesehatan</strong>,<br><strong>pendidikan</strong>,
                    dan <strong>masa depan</strong>.</h2>
            </div>
        </div>

        <!-- Scene 3: Perlawanan -->
        <div class="intro-scene" id="scene-3">
            <div class="ban-symbol">
                <i class="fa-solid fa-skull-crossbones"></i>
            </div>
            <div class="scene3-text">
                <h1>Katakan <span>TIDAK</span><br>Pada Narkoba</h1>
            </div>
        </div>

        <!-- Scene 4: Masa Depan Cerah -->
        <div class="intro-scene" id="scene-4">
            <div class="floating-positive">
                <div class="positive-obj"><i class="fa-solid fa-book-open"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-laptop-code"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-trophy"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-volleyball"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-music"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-people-roof"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-graduation-cap"></i></div>
                <div class="positive-obj"><i class="fa-solid fa-heart-pulse"></i></div>
            </div>
            <div class="scene4-text">
                <h1>Pilih <span>Prestasi</span>,<br>Kesehatan, dan Masa Depan</h1>
                <p class="tagline">PIK-R JP ONE &mdash; Generasi Bebas Narkoba</p>
            </div>
        </div>
    </div>

    <!-- Skip Button -->
    <button id="intro-skip">Skip <i class="fa-solid fa-forward"></i></button>

    <!-- Progress Bar -->
    <div id="intro-progress" style="width: 0%;"></div>

    <!-- Scene Indicators -->
    <div class="scene-indicators">
        <div class="scene-dot" data-scene="0"></div>
        <div class="scene-dot" data-scene="1"></div>
        <div class="scene-dot" data-scene="2"></div>
        <div class="scene-dot" data-scene="3"></div>
    </div>

    <!-- Loading Screen -->
    <div id="loader">
        <div class="spinner"></div>
        <h2>Memuat Edukasi...</h2>
    </div>

    <!-- Audio (Optional Backsound) -->
    <audio id="bg-music" loop>
        <source
            src="https://cdn.pixabay.com/download/audio/2022/10/14/audio_9939f792cb.mp3?filename=lofi-study-112191.mp3"
            type="audio/mpeg">
    </audio>

    <!-- Navbar -->
    <nav class="navbar glassmorphism">
        <div class="logo">
            <h1><i class="fa-solid fa-shield-halved"></i> PIK-R JP ONE</h1>
        </div>
        <ul class="nav-links">
            <li><a href="#hero">Beranda</a></li>
            <li><a href="#tentang">Tentang</a></li>
            <li><a href="#golongan">Golongan</a></li>
            <li><a href="#dampak">Dampak</a></li>
            <li><a href="#pencegahan">Pencegahan</a></li>
            <li><a href="#quiz">Quiz</a></li>
            <li><a href="#game">Game</a></li>
            <li><a href="#about-pikr" id="nav-about-pikr">ABOUT PIK-R</a></li>
        </ul>
        <div class="nav-controls">
            <button id="audio-toggle" title="Play/Pause Music"><i class="fa-solid fa-volume-xmark"></i></button>
            <button id="theme-toggle" title="Toggle Dark/Light Mode"><i class="fa-solid fa-sun"></i></button>
            <div class="hamburger">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" class="hero-section">
        <!-- Background Bergerak Halus & Gradient Animation -->
        <div class="hero-bg-gradient left"></div>
        <div class="hero-bg-gradient right"></div>

        <!-- Floating Decor Icons -->
        <div class="hero-floating-icons">
            <i class="fa-solid fa-capsules floating-icon-deco"
                style="top: 15%; left: 10%; --fi-dur: 6s; --fi-delay: 0s;"></i>
            <i class="fa-solid fa-shield-halved floating-icon-deco"
                style="top: 25%; right: 15%; --fi-dur: 8s; --fi-delay: 1s;"></i>
            <i class="fa-solid fa-heart-pulse floating-icon-deco"
                style="bottom: 20%; left: 20%; --fi-dur: 7s; --fi-delay: 2s;"></i>
            <i class="fa-solid fa-book-open floating-icon-deco"
                style="bottom: 15%; right: 25%; --fi-dur: 9s; --fi-delay: 0.5s;"></i>
        </div>

        <div class="hero-content fade-in">
            <div class="badge">Website by PIK-R JP ONE</div>
            <h1 class="hero-title">Edukasi <span class="text-glow">Bahaya Narkoba</span></h1>
            <p class="hero-subtitle">Kenali bahayanya, lindungi masa depanmu. Jangan biarkan narkoba merenggut mimpimu.
            </p>
            <a href="#tentang" class="btn-primary glow-button">Mulai Belajar <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="hero-image fade-in">
            <!-- PIK-R Logo -->
            <img src="logo-pikr.png" alt="Logo PIK-R SMK JP 1" class="hero-logo pulse-animation">
        </div>

        <!-- Scroll indicator -->
        <div class="scroll-indicator"
            onclick="document.getElementById('stats-section').scrollIntoView({behavior: 'smooth'})">
            <span>Scroll</span>
            <i class="fa-solid fa-chevron-down"></i>
        </div>
    </section>

    <!-- ============================================
         COUNTER STATISTIK SECTION
         ============================================ -->
    <section id="stats-section" class="stats-section" data-ao="fade-up">
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fa-solid fa-graduation-cap stat-icon"></i>
                <div class="stat-number stat-count" data-target="500" data-suffix="+">0+</div>
                <div class="stat-label">Remaja Telah<br>Teredukasi</div>
            </div>
            <div class="stat-card">
                <i class="fa-solid fa-calendar-check stat-icon"></i>
                <div class="stat-number stat-count" data-target="20" data-suffix="+">0+</div>
                <div class="stat-label">Kegiatan &amp;<br>Program Kerja</div>
            </div>
            <div class="stat-card">
                <i class="fa-solid fa-users-gear stat-icon"></i>
                <div class="stat-number stat-count" data-target="16" data-suffix="">0</div>
                <div class="stat-label">Pengurus Aktif<br>PIK-R JP ONE</div>
            </div>
            <div class="stat-card">
                <i class="fa-solid fa-shield-heart stat-icon"></i>
                <div class="stat-number stat-count" data-target="100" data-suffix="%">0%</div>
                <div class="stat-label">Komitmen Penuh<br>Anti Narkoba</div>
            </div>
        </div>
    </section>

    <!-- Tentang Section -->
    <section id="tentang" class="section">
        <div class="section-header fade-in">
            <h2>Apa itu <span class="text-glow">Narkoba?</span></h2>
            <p>Mari pahami musuh kita bersama.</p>
        </div>
        <div class="about-grid">
            <div class="about-card glassmorphism fade-in">
                <i class="fa-solid fa-pills about-icon"></i>
                <h3>Pengertian</h3>
                <p>Narkoba (Narkotika dan Obat/Bahan Berbahaya) adalah zat yang jika dimasukkan ke dalam tubuh dapat
                    mengubah pikiran, suasana hati, dan perilaku seseorang.</p>
            </div>
            <div class="about-card glassmorphism fade-in">
                <i class="fa-solid fa-triangle-exclamation about-icon"></i>
                <h3>Mengapa Berbahaya?</h3>
                <p>Zat ini merusak sistem saraf otak, menyebabkan kecanduan parah, merusak organ tubuh vital, dan bisa
                    berujung pada kematian.</p>
            </div>
            <div class="about-card glassmorphism fade-in">
                <i class="fa-solid fa-users-rays about-icon"></i>
                <h3>Siapa Korbannya?</h3>
                <p>Narkoba tidak pandang bulu. Siapapun bisa menjadi korban, terutama remaja dan anak muda yang sedang
                    mencari jati diri atau mengalami stres.</p>
            </div>
        </div>
    </section>

    <!-- Golongan Section -->
    <section id="golongan" class="section bg-darker">
        <div class="section-header fade-in">
            <h2>Golongan <span class="text-glow">Narkotika</span></h2>
            <p>Kenali jenisnya agar tidak salah langkah.</p>
        </div>
        <div class="cards-container">
            <div class="golongan-card glassmorphism fade-in">
                <div class="card-badge golongan-1">Golongan I</div>
                <h3>Paling Berbahaya</h3>
                <ul>
                    <li><strong>Pengertian:</strong> Hanya untuk ilmu pengetahuan, tidak untuk pengobatan. Potensi
                        ketergantungan sangat tinggi.</li>
                    <li><strong>Contoh:</strong>
                        <span class="drug-link glow-hover" data-drug="ganja">Ganja</span>,
                        <span class="drug-link glow-hover" data-drug="sabu">Sabu-sabu</span>,
                        <span class="drug-link glow-hover" data-drug="kokain">Kokain</span>,
                        <span class="drug-link glow-hover" data-drug="opium">Opium</span>,
                        <span class="drug-link glow-hover" data-drug="heroin">Heroin</span>.
                    </li>
                    <li><strong>Dampak:</strong> Halusinasi akut, kerusakan otak permanen, kematian.</li>
                </ul>
            </div>
            <div class="golongan-card glassmorphism fade-in">
                <div class="card-badge golongan-2">Golongan II</div>
                <h3>Berbahaya</h3>
                <ul>
                    <li><strong>Pengertian:</strong> Bisa untuk pengobatan sebagai pilihan terakhir. Potensi
                        ketergantungan tinggi.</li>
                    <li><strong>Contoh:</strong>
                        <span class="drug-link glow-hover" data-drug="morfin">Morfin</span>,
                        <span class="drug-link glow-hover" data-drug="fentanil">Fentanil</span>,
                        <span class="drug-link glow-hover" data-drug="metadon">Metadon</span>.
                    </li>
                    <li><strong>Dampak:</strong> Depresi sistem pernapasan, penurunan kesadaran, koma.</li>
                </ul>
            </div>
            <div class="golongan-card glassmorphism fade-in">
                <div class="card-badge golongan-3">Golongan III</div>
                <h3>Risiko Ringan</h3>
                <ul>
                    <li><strong>Pengertian:</strong> Banyak digunakan untuk pengobatan dan terapi. Potensi
                        ketergantungan ringan.</li>
                    <li><strong>Contoh:</strong>
                        <span class="drug-link glow-hover" data-drug="kodein">Kodein</span>,
                        <span class="drug-link glow-hover" data-drug="buprenorfin">Buprenorfin</span>.
                    </li>
                    <li><strong>Dampak:</strong> Mual, pusing, konstipasi, tetap bisa memicu kecanduan jika
                        disalahgunakan.</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Dampak Section -->
    <section id="dampak" class="section">
        <div class="section-header fade-in">
            <h2>Bahaya & <span class="text-glow">Dampak</span></h2>
            <p>Kehancuran di berbagai aspek kehidupan.</p>
        </div>
        <div class="impact-grid">
            <div class="impact-item fade-in">
                <div class="impact-icon"><i class="fa-solid fa-heart-crack"></i></div>
                <div class="impact-content">
                    <h4>Kesehatan Tubuh</h4>
                    <p>Kerusakan organ seperti hati, paru-paru, jantung, dan risiko infeksi HIV/AIDS akibat jarum
                        suntik.</p>
                </div>
            </div>
            <div class="impact-item fade-in">
                <div class="impact-icon"><i class="fa-solid fa-brain"></i></div>
                <div class="impact-content">
                    <h4>Mental & Psikologis</h4>
                    <p>Memicu depresi berat, halusinasi, kecemasan berlebih (paranoid), hingga gangguan jiwa.</p>
                </div>
            </div>
            <div class="impact-item fade-in">
                <div class="impact-icon"><i class="fa-solid fa-handcuffs"></i></div>
                <div class="impact-content">
                    <h4>Dampak Sosial</h4>
                    <p>Terkucilkan dari masyarakat, mendorong tindakan kriminal untuk membeli narkoba, hingga penjara.
                    </p>
                </div>
            </div>
            <div class="impact-item fade-in">
                <div class="impact-icon"><i class="fa-solid fa-house-crack"></i></div>
                <div class="impact-content">
                    <h4>Keluarga</h4>
                    <p>Menghancurkan keharmonisan keluarga, menguras ekonomi, dan membawa aib serta kesedihan.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Pencegahan Section -->
    <section id="pencegahan" class="section bg-darker">
        <div class="section-header fade-in">
            <h2>Langkah <span class="text-glow">Pencegahan</span></h2>
            <p>Lindungi dirimu mulai dari sekarang.</p>
        </div>
        <div class="timeline">
            <div class="timeline-item fade-in">
                <div class="timeline-icon"><i class="fa-solid fa-users"></i></div>
                <div class="timeline-content glassmorphism">
                    <h3>Pilih Pergaulan Sehat</h3>
                    <p>Bertemanlah dengan orang-orang yang membawa pengaruh positif dan jauhi lingkungan toksik.</p>
                </div>
            </div>
            <div class="timeline-item fade-in">
                <div class="timeline-icon"><i class="fa-solid fa-person-running"></i></div>
                <div class="timeline-content glassmorphism">
                    <h3>Aktif Kegiatan Positif</h3>
                    <p>Isi waktu luang dengan olahraga, seni, organisasi, atau hobi yang bermanfaat.</p>
                </div>
            </div>
            <div class="timeline-item fade-in">
                <div class="timeline-icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
                <div class="timeline-content glassmorphism">
                    <h3>Berani Berkata "TIDAK"</h3>
                    <p>Punya pendirian teguh untuk menolak segala bentuk tawaran narkoba dari siapapun.</p>
                </div>
            </div>
            <div class="timeline-item fade-in">
                <div class="timeline-icon"><i class="fa-solid fa-phone"></i></div>
                <div class="timeline-content glassmorphism">
                    <h3>Cari Bantuan</h3>
                    <p>Jika ada masalah atau terlanjur terjerumus, jangan takut cerita ke keluarga, guru, atau konselor.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Motivasi Section -->
    <section id="motivasi" class="section quotes-section">
        <div class="quote-container fade-in">
            <i class="fa-solid fa-quote-left quote-mark"></i>
            <h2 id="quote-text" class="quote-text">Masa depan cerah dimulai dari hidup sehat.</h2>
            <i class="fa-solid fa-quote-right quote-mark"></i>
        </div>
    </section>

    <!-- Quiz Section -->
    <section id="quiz" class="section">
        <div class="section-header fade-in">
            <h2>Uji <span class="text-glow">Pengetahuanmu</span></h2>
            <p>Seberapa paham kamu tentang bahaya narkoba?</p>
        </div>
        <div class="quiz-container glassmorphism fade-in">
            <div id="quiz-intro">
                <h3>Quiz Interaktif Anti Narkoba</h3>
                <p>Jawab pertanyaan berikut untuk menguji pengetahuanmu!</p>
                <button id="start-quiz-btn" class="btn-primary">Mulai Quiz</button>
            </div>
            <div id="quiz-area" class="hidden">
                <div class="progress-bar-container">
                    <div id="progress-bar"></div>
                </div>
                <h3 id="question-text">Pertanyaan akan muncul di sini.</h3>
                <div id="options-container" class="options-grid">
                    <!-- Options injected by JS -->
                </div>
                <p id="feedback-message"></p>
            </div>
            <div id="quiz-result" class="hidden">
                <h3>Hasil Quiz</h3>
                <h1 id="score-text" class="text-glow">0/10</h1>
                <p id="result-message"></p>
                <button id="restart-quiz-btn" class="btn-primary">Main Lagi</button>
            </div>
        </div>
    </section>

    <!-- Mini Game Section -->
    <section id="game" class="section bg-darker">
        <div class="section-header fade-in">
            <h2>Mini Game: <span class="text-glow">Pilih yang Sehat!</span></h2>
            <p>Tangkap item positif (Buku, Apel, Musik) dan hindari Narkoba (Pil, Suntikan)!</p>
        </div>
        <div class="game-container glassmorphism fade-in">
            <div class="game-header">
                <div>Skor: <span id="game-score">0</span> / 150</div>
                <div>Waktu: <span id="game-time">30</span>s</div>
            </div>
            <div id="game-board">
                <div id="game-start-overlay">
                    <button id="start-game-btn" class="btn-primary glow-button">Mulai Game</button>
                </div>
                <div id="game-over-overlay" class="hidden">
                    <h3 id="game-over-title">Game Over!</h3>
                    <p>Skor Akhir: <span id="final-score">0</span></p>
                    <p id="game-message" class="text-glow">Hidup sehat tanpa narkoba!</p>
                    <button id="restart-game-btn" class="btn-primary">Main Lagi</button>
                </div>
                <!-- Player -->
                <div id="player"><i class="fa-solid fa-basket-shopping"></i></div>
            </div>
        </div>
    </section>

    <!-- Mini Game 2: Escape From Drugs Section -->
    <section id="escape-game" class="section">
        <div class="section-header fade-in">
            <h2>Game 2: <span class="text-glow">Escape From Drugs</span></h2>
            <p>Bebaskan dirimu! Kumpulkan hal positif dan hindari narkoba yang mengejarmu!</p>
        </div>
        <div class="game-container glassmorphism fade-in">
            <div class="game-header">
                <div>Skor: <span id="escape-score">0</span> / 100</div>
                <div class="lives-container" style="color: var(--primary-color);">Nyawa: <span
                        id="escape-lives">❤️❤️❤️</span></div>
                <div>Waktu: <span id="escape-time">60</span>s</div>
            </div>
            <div class="game-controls" style="text-align: right; margin-bottom: 10px;">
                <button id="escape-pause-btn" class="btn-primary" style="padding: 5px 15px; font-size: 0.9rem;"><i
                        class="fa-solid fa-pause"></i> Pause</button>
            </div>

            <div id="escape-board"
                style="position: relative; width: 100%; height: 400px; background-color: rgba(41, 128, 185, 0.12); border-radius: 10px; overflow: hidden; border: 2px solid var(--glass-border); touch-action: none;">
                <!-- Audio SFX -->
                <audio id="sfx-collect"
                    src="https://cdn.pixabay.com/download/audio/2021/08/04/audio_0625c1539c.mp3?filename=success-1-6297.mp3"></audio>
                <audio id="sfx-hit"
                    src="https://cdn.pixabay.com/download/audio/2021/08/04/audio_c6ccf3232f.mp3?filename=negative_beeps-6008.mp3"></audio>

                <!-- Overlays -->
                <div id="escape-start-overlay" class="game-overlay">
                    <h3 style="font-size: 1.8rem; margin-bottom: 10px;">Escape From Drugs</h3>
                    <p style="margin-bottom: 15px; padding: 0 20px;">Gunakan <b>WASD</b> / <b>Arah Panah</b> (atau
                        tombol sentuh di HP) untuk bergerak.<br>Kumpulkan hal positif (+10) dan hindari narkoba! Nyawa
                        berkurang jika terkena narkoba.</p>
                    <button id="escape-start-btn" class="btn-primary glow-button">Mulai Main</button>
                </div>

                <div id="escape-pause-overlay" class="game-overlay hidden" style="background: rgba(12, 25, 41, 0.7);">
                    <h3 style="font-size: 2rem;">Game Paused</h3>
                    <button id="escape-resume-btn" class="btn-primary" style="margin-top: 15px;">Lanjutkan</button>
                </div>

                <div id="escape-over-overlay" class="game-overlay hidden">
                    <h3 id="escape-over-title">Game Over!</h3>
                    <p>Skor Akhir: <span id="escape-final-score">0</span></p>
                    <p id="escape-message" class="text-glow" style="margin: 10px 0;">Jangan biarkan narkoba
                        menghancurkan masa depanmu.</p>
                    <button id="escape-restart-btn" class="btn-primary">Main Lagi</button>
                </div>

                <!-- Player Character -->
                <div id="escape-player"
